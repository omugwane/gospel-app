# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: mux:seed-secrets; sanity:rename-daniel-titles; sanity:daniel-youtube-to-audio (needs yt-dlp + ffmpeg locally)
# SANITY_API_WRITE_TOKEN=

# Mux — used by scripts/seed-mux-secrets.mjs; Studio reads credentials from dataset after seeding (or configure in Videos → Configure plugin)
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# Firebase
# Deploy Firestore rules: from repo root `npm install && npm run firebase:deploy-rules`, or from `./web/` run the same npm script (`npm run firebase:deploy-rules` uses ../scripts and reads NEXT_PUBLIC_FIREBASE_PROJECT_ID from web/.env.local).
# Optionally copy ../firebaserc.example to ../.firebaserc and set default project id.
# Deploy `firestore.rules` to your Firebase project before enabling profile sync writes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
